{
  "name": "@lmoesle/token-usage-cli",
  "version": "0.9.0",
  "description": "CLI for tracking AI agent token usage",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmoesle/token-usage"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "token-usage": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run typecheck && webpack && npm run typecheck:consumer",
    "lint": "eslint .",
    "prepack": "npm run build",
    "start": "npm run build && node dist/index.js",
    "test": "npm run typecheck && jest",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "typecheck:consumer": "tsc6 --project tsconfig.consumer.json"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "ts-loader": "^9.6.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
